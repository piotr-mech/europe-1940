---
import { BoardMap } from "@/components/game/BoardMap";
import Layout from "@/layouts/Layout.astro";
import { createInitialGameState } from "@/lib/game-state";

// Demo wiring (phase 2): fixed germany-vs-soviet state so the board's
// readability can be judged before the setup screen lands (phase 3).
const demoState = createInitialGameState("germany", "soviet");
---

<Layout title="EUROPE 1940">
  <main class="mx-auto max-w-6xl px-4 py-6">
    <h1 class="mb-4 text-2xl font-bold">EUROPE 1940</h1>
    <BoardMap state={demoState} client:only="react" />
  </main>
</Layout>
